      "primary_kpi_use": "Reality-check exposure by program (diagnostic)",
      "ga4_recommended": false,
      "notes": "Wired for V5 by DEC-038 (the redesigned result never emitted it before; V3/V4 still do not)."
    },
    {
      "event_name": "result_feedback_view",
      "category": "feedback",
      "trigger_description": "The pilot feedback block is at least half visible (once per result state).",
      "required_params": ["flow_version", "entry_mode", "comparison_id", "result_kind", "feedback_version"],
      "optional_params": [
        "recommended_program",
        "alternative_programs",
        "scored_answer_count",
        "total_answer_count",
        "project_ids",
        "world_ids"
      ],
      "primary_kpi_use": "Feedback response rate (denominator)",
