      "optional_params": ["selected_project_count", "project_ids", "selected_world_count", "world_ids"],
      "primary_kpi_use": "Spotify / Technology precision handoff rate",
      "ga4_recommended": true,
      "notes": "seeded_answer_count = 1 when the Spotify opener or WT1 was carried in as V1 Q1."
    },
    {
      "event_name": "question_view",
      "category": "questions",
      "trigger_description": "A question is shown (deduplicated per journey position).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "question_id",
        "question_index",
        "question_mode"
      ],
      "optional_params": [
        "question_kind",
        "is_generated_focus",
        "focus_program_count",
        "selected_project_count",
        "project_ids",
        "selected_world_count",
        "world_ids"
      ],
      "primary_kpi_use": "Question drop-off (by question_index / question_id)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "question_continue",
      "category": "questions",
      "trigger_description": "Continue pressed on a question (before the answer is committed).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "question_id",
        "question_index",
        "question_mode"
      ],
      "optional_params": ["question_kind", "is_generated_focus", "focus_program_count", "project_ids", "world_ids"],
      "primary_kpi_use": "Question friction (diagnostic)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "question_answer",
      "category": "questions",
      "trigger_description": "An answer is committed (only on Continue, never on selection changes).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "question_id",
        "question_index",
        "question_mode",
        "answer_id",
        "is_neutral"
      ],
      "optional_params": ["question_kind", "is_generated_focus", "focus_program_count", "project_ids", "world_ids"],
      "primary_kpi_use": "Answer distribution per question; neutral rate",
      "ga4_recommended": true,
      "notes": "answer_id is an option id (A/B/C/neither...), never the answer text."
    },
    {
      "event_name": "discovery_back",
      "category": "questions",
      "trigger_description": "Back from a question (to the previous answer or, from the first question, to discovery).",
      "required_params": ["flow_version", "entry_mode", "questions_answered"],
      "optional_params": [
        "comparison_id",
        "project_ids",
        "world_ids",
        "selected_project_count",
        "selected_world_count"
      ],
      "primary_kpi_use": "Back usage (diagnostic)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "comparison_completed",
      "category": "result",
      "trigger_description": "The last answer completes the journey (a result exists).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "result_kind",
        "scored_answer_count",
        "total_answer_count",
        "questions_answered"
      ],
      "optional_params": ["recommended_program", "alternative_programs", "project_ids", "world_ids"],
      "primary_kpi_use": "Completion (alternative numerator); engine outcome per completed run",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "recommended_program",
      "category": "result",
      "trigger_description": "Same moment as comparison_completed, only when a program is recommended.",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "result_kind",
        "recommended_program",
        "scored_answer_count",
        "total_answer_count"
      ],
      "optional_params": ["alternative_programs", "project_ids", "world_ids"],
      "primary_kpi_use": "Recommendation distribution; Business Administration share",
      "ga4_recommended": true,
      "notes": "Event name equals a parameter name (historical V1 vocabulary); do not rename."
    },
    {
      "event_name": "studymatch_result_view",
      "category": "result",
      "trigger_description": "The result page is shown (once per result state).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "result_kind",
        "scored_answer_count",
        "total_answer_count"
      ],
      "optional_params": [
        "recommended_program",
        "alternative_programs",
        "project_ids",
        "world_ids",
        "selected_project_count",
        "selected_world_count"
      ],
      "primary_kpi_use": "Results; Questionnaire Completion Rate (numerator); result-kind rates; questions to result",
      "ga4_recommended": true,
      "notes": "result_kind: recommended | near_tie | insufficient_positive_evidence | v1_precision_result."
    },
    {
      "event_name": "result_program_click",
      "category": "conversion",
      "trigger_description": "An official program link is opened from the result (opens in a new tab, with the outbound UTMs).",
