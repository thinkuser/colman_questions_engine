{
  "version": "v5-pilot-1",
  "flow_version": "v5",
  "notes": [
    "Source of truth for the V5 pilot measurement contract (DEC-038). Human-readable companion: docs/V5_PILOT_MEASUREMENT.md.",
    "Transport: trackEvent() -> window.dataLayer.push({ event, ...params }). Only parameters listed in src/analytics/events.ts ANALYTICS_PARAMS can be sent (structural privacy guard). Non-applicable parameters are omitted, never sent as empty strings.",
    "journey_context = flow_version, entry_mode, comparison_id (once the journey started), selected_project_count + project_ids (project mode) OR selected_world_count + world_ids (world mode), and inbound utm_* when the visit had them.",
    "result_context = journey_context + result_kind, recommended_program (if any), alternative_programs (if any), scored_answer_count, total_answer_count.",
    "question_context = journey_context + question_id, question_index, question_mode, question_kind (generic questions), is_generated_focus, focus_program_count (generated focus only).",
    "Semantic events are the KPI source of truth. ui_click is UX evidence only and fires IN ADDITION to them.",
    "tests/analytics/pilotMeasurement.test.ts checks that every event and parameter named here is part of the analytics vocabulary."
  ],
  "context_groups": {
    "journey_context": [
      "flow_version",
      "entry_mode",
      "comparison_id",
      "selected_project_count",
      "project_ids",
      "selected_world_count",
      "world_ids",
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term"
    ],
    "result_context": [
      "result_kind",
      "recommended_program",
      "alternative_programs",
      "scored_answer_count",
      "total_answer_count"
    ],
    "question_context": [
      "question_id",
      "question_index",
      "question_mode",
      "question_kind",
      "is_generated_focus",
      "focus_program_count"
    ]
  },
  "events": [
    {
      "event_name": "studymatch_landing_view",
      "category": "funnel",
      "trigger_description": "The /v5 landing is shown (once per mounted view).",
      "required_params": ["flow_version"],
      "optional_params": ["entry_mode", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Landing -> Start Rate (denominator)",
      "ga4_recommended": true,
      "notes": "Pre-journey: no comparison_id. entry_mode only for a returning candidate."
    },
    {
      "event_name": "studymatch_start",
      "category": "funnel",
      "trigger_description": "The landing CTA is pressed.",
      "required_params": ["flow_version"],
      "optional_params": ["entry_mode", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Landing -> Start Rate (numerator); Starts",
      "ga4_recommended": true,
      "notes": "Pre-journey."
    },
    {
      "event_name": "discovery_method_view",
      "category": "funnel",
      "trigger_description": "The /v5/start method screen is shown (once per mounted view).",
      "required_params": ["flow_version"],
      "optional_params": ["entry_mode", "utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Method choice rate (denominator)",
      "ga4_recommended": true,
      "notes": "Absent for externally assigned traffic (direct /v5/worlds or /v5/projects)."
    },
    {
      "event_name": "discovery_method_selected",
      "category": "funnel",
      "trigger_description": "The candidate chooses Worlds or Projects on /v5/start.",
      "required_params": ["flow_version", "entry_mode"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Self-selected share Worlds vs Projects; cohort flag (self-selected)",
      "ga4_recommended": true,
      "notes": "Never fabricated for direct /v5/worlds or /v5/projects visits (externally assigned)."
    },
    {
      "event_name": "career_project_discovery_view",
      "category": "discovery",
      "trigger_description": "The V5 projects screen is shown (project mode).",
      "required_params": ["flow_version", "entry_mode", "project_count_available"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery Completion Rate (denominator, project mode)",
      "ga4_recommended": true,
      "notes": "project_count_available = 10 in V5."
    },
    {
      "event_name": "career_project_selected",
      "category": "discovery",
      "trigger_description": "A project card is selected (a refused third selection emits nothing).",
      "required_params": ["flow_version", "entry_mode", "project_id", "selected_project_count", "selection_position"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Selection count / share per project; pair order (selection_position)",
      "ga4_recommended": true,
      "notes": "V5 project ids: spotify_discovery, wolt_city_expansion, tiktok_behavior, duolingo_persistence, people_retention, people_change, ai_legal_case, accounting_gap, nike_launch, apple_store_space."
    },
    {
      "event_name": "career_project_deselected",
      "category": "discovery",
      "trigger_description": "A selected project card is deselected.",
      "required_params": ["flow_version", "entry_mode", "project_id", "selected_project_count"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery friction (diagnostic)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "career_project_selection_completed",
      "category": "discovery",
      "trigger_description": "Continue on the projects screen with a valid selection (the journey starts).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "selected_project_count",
        "project_ids",
        "selection_count"
      ],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery Completion Rate (numerator, project mode); pair-selection share",
      "ga4_recommended": true,
      "notes": "project_ids is canonical (sorted, pipe-joined); the order is on career_project_selected.selection_position."
    },
    {
      "event_name": "career_world_discovery_view",
      "category": "discovery",
      "trigger_description": "The V5 worlds screen is shown (world mode).",
      "required_params": ["flow_version", "entry_mode", "world_count_available"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery Completion Rate (denominator, world mode)",
      "ga4_recommended": true,
      "notes": "world_count_available = 9."
    },
    {
      "event_name": "career_world_selected",
      "category": "discovery",
      "trigger_description": "A world card is selected (a refused third selection emits nothing).",
      "required_params": ["flow_version", "entry_mode", "world_id", "selected_world_count", "selection_position"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Selection count / share per world",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "career_world_deselected",
      "category": "discovery",
      "trigger_description": "A selected world card is deselected.",
      "required_params": ["flow_version", "entry_mode", "world_id", "selected_world_count"],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery friction (diagnostic)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "career_world_selection_completed",
      "category": "discovery",
      "trigger_description": "Continue on the worlds screen with a valid selection (the journey starts).",
      "required_params": [
        "flow_version",
        "entry_mode",
        "comparison_id",
        "selected_world_count",
        "world_ids",
        "selection_count"
      ],
      "optional_params": ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"],
      "primary_kpi_use": "Discovery Completion Rate (numerator, world mode)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "comparison_started",
      "category": "funnel",
      "trigger_description": "The journey starts (right after *_selection_completed).",
      "required_params": ["flow_version", "entry_mode", "comparison_id"],
      "optional_params": [
        "selected_project_count",
        "project_ids",
        "selected_world_count",
        "world_ids",
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term"
      ],
      "primary_kpi_use": "Questionnaire Completion Rate (denominator)",
      "ga4_recommended": true,
      "notes": ""
    },
    {
      "event_name": "precision_module_handoff",
      "category": "engine",
      "trigger_description": "The journey hands off to the V1 Tech precision module.",
