        "program_id",
        "question_id",
        "question_index",
        "question_mode",
        "question_kind",
        "answer_id",
        "cta_position",
        "link_role",
        "detail_section",
        "feedback_fit",
        "feedback_helpfulness",
        "result_kind",
        "recommended_program",
        "alternative_programs",
        "scored_answer_count",
        "total_answer_count",
        "project_ids",
        "world_ids",
        "selected_project_count",
        "selected_world_count",
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term"
      ],
      "primary_kpi_use": "UX / click coverage / debugging only (never a funnel KPI)",
