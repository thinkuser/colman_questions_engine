        "flow_version",
        "entry_mode",
        "comparison_id",
        "result_kind",
        "program_id",
        "link_role",
        "cta_position"
      ],
      "optional_params": [
        "recommended_program",
        "alternative_programs",
        "scored_answer_count",
        "total_answer_count",
        "project_ids",
        "world_ids"
      ],
      "primary_kpi_use": "Program Click Rate; CTA performance",
      "ga4_recommended": true,
      "notes": "link_role: primary | alternative | peer. cta_position: hero | secondary | weak_direction | colman_section. This is the V3+ equivalent of V2's official_program_click (not emitted by V5)."
    },
    {
      "event_name": "result_contact_click",
      "category": "conversion",
