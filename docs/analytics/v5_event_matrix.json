        "recommended_program",
        "alternative_programs",
        "scored_answer_count",
        "total_answer_count",
        "project_ids",
        "world_ids"
      ],
      "primary_kpi_use": "Contact Intent Rate",
      "ga4_recommended": true,
      "notes": "cta_position: hero | colman_section | sticky."
    },
    {
      "event_name": "result_all_programs_click",
      "category": "conversion",
      "trigger_description": "The all-programs link is opened (new tab, outbound UTMs).",
      "required_params": ["flow_version", "entry_mode", "comparison_id", "result_kind"],
      "optional_params": [
        "recommended_program",
        "alternative_programs",
        "scored_answer_count",
        "total_answer_count",
        "project_ids",
        "world_ids"
      ],
      "primary_kpi_use": "Downstream exploration",
      "ga4_recommended": true,
      "notes": ""
