# Copy to .env.local (never commit real values)
# Destination of the "speak with an advisor" CTA on the result page.
# When empty the CTA is not shown; no contact destination is hardcoded.
NEXT_PUBLIC_ADVISOR_URL=

# SERVER-ONLY destination of the V2 lead form (the same-origin /api/v2/lead forwards each lead here as a JSON POST).
# Never use a NEXT_PUBLIC_ prefix: the URL must not reach the browser. Leave empty to disable lead delivery:
# the API then answers 503 and the form shows an honest error (it never pretends a lead was sent).
LEAD_WEBHOOK_URL=

# V5 pilot (DEC-038): Google Tag Manager container for /v5 only, e.g. GTM-ABC1234. Public by design (not a secret).
# Leave empty to load no GTM (events still go to window.dataLayer). See docs/GTM_V5_IMPLEMENTATION.md.
NEXT_PUBLIC_GTM_ID=

# SERVER-ONLY destination of the V5 pilot feedback (the same-origin /api/v5/feedback forwards each structured response
# to an n8n webhook that appends it to the "Feedback" tab). Never use a NEXT_PUBLIC_ prefix. Empty means persistence is
# unavailable: the API answers 503 and the feedback block shows a retry message (it never pretends feedback was saved).
FEEDBACK_WEBHOOK_URL=
