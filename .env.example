# Copy to .env.local (never commit real values)
# Destination of the "speak with an advisor" CTA on the result page.
# When empty the CTA is not shown; no contact destination is hardcoded.
NEXT_PUBLIC_ADVISOR_URL=

# SERVER-ONLY destination of the V2 lead form (the same-origin /api/v2/lead forwards each lead here as a JSON POST).
# Never use a NEXT_PUBLIC_ prefix: the URL must not reach the browser. Leave empty to disable lead delivery:
# the API then answers 503 and the form shows an honest error (it never pretends a lead was sent).
LEAD_WEBHOOK_URL=
